          },
          "repair_steps": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "root_cause": {
            "type": "string"
          },
          "runtime_stage": {
            "type": "string"
          },
          "signature_id": {
            "type": "string"
          },
          "source_claim_ids": {
