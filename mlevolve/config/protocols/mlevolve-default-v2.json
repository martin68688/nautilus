{
  "protocol_id": "mlevolve-default",
  "version": "2",
  "parent_version": "1",
  "task_profile": {"scope": "task-local"},
  "data_split_policy": {"fit_scope": "training_partition_only", "outer_holdout_feedback": false},
  "preprocessing_policy": {"fit_scope": "fold_train_only"},
  "evaluator_spec": {"source": "task_config", "immutable_during_run": true},
  "metric_spec": {"direction": "runtime_determined", "best_seed_selection": false},
  "selection_policy": {"freeze_before_final_evaluation": true},
  "seed_policy": {"pairwise_min_seeds": 3, "best_seed_selection": false},
  "holdout_policy": {"terminal_only": true, "reuse_for_search": false},
  "promotion_policy": {
    "require_complete_evidence": true,
    "clean_replay": {
      "allowed_protocol_changes": [
        "split_api",
        "preprocessing_scope",
        "evaluator",
        "selection_freeze",
        "seed_aggregation",
        "holdout_access",
        "instrumentation"
      ]
    }
  },
  "compatibility_rules": {"accepted_protocol_hashes": []},
  "canonical_hash": ""
}
