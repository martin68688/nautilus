{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "autoresearch-spooky-a10-20260918",
    "namespace": "ecepxie",
    "labels": {
      "ecepxie.nrp/owner": "haoming",
      "app.kubernetes.io/managed-by": "codex-nrp-training",
      "experiment": "autoresearch-spooky-a10-20260918"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 25200,
    "automountServiceAccountToken": false,
    "affinity": {
      "nodeAffinity": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "nodeSelectorTerms": [
            {
              "matchExpressions": [
                {
                  "key": "nvidia.com/gpu.product",
                  "operator": "In",
                  "values": [
                    "NVIDIA-A10"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "containers": [
      {
        "name": "worker",
        "image": "docker.io/haomingwang22/mlevolve@sha256:fe0b9c383391d3e62e9f321943b4fdedaa4df54ad7f45b0395c8647a195c20cc",
        "command": [
          "python",
          "-c",
          "import time; time.sleep(25000)"
        ],
        "resources": {
          "requests": {
            "cpu": "8",
            "memory": "32Gi",
            "nvidia.com/gpu": "1",
            "ephemeral-storage": "24Gi"
          },
          "limits": {
            "cpu": "8",
            "memory": "32Gi",
            "nvidia.com/gpu": "1",
            "ephemeral-storage": "24Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/data",
            "subPath": "experiments/spooky-free-linear-terra-r1-fixed-20260910/public",
            "readOnly": true
          },
          {
            "name": "scratch",
            "mountPath": "/scratch"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "data",
        "persistentVolumeClaim": {
          "claimName": "haoming-storage"
        }
      },
      {
        "name": "scratch",
        "emptyDir": {
          "sizeLimit": "24Gi"
        }
      }
    ]
  }
}