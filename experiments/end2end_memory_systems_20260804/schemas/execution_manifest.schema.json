{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlevolve_end2end_execution_manifest_v1",
  "type": "object",
  "required": [
    "schema",
    "release_id",
    "comparison_baseline_release_id",
    "kind",
    "formal_result_eligible",
    "exploratory_pilot",
    "seed",
    "system_ids",
    "task_ids",
    "run_count",
    "bindings",
    "runs",
    "manifest_hash"
  ],
  "properties": {
    "schema": {"const": "mlevolve_end2end_execution_manifest_v1"},
    "release_id": {
      "enum": [
        "end2end-agentic-three-role-v12",
        "end2end-agentic-three-role-v13"
      ]
    },
    "comparison_baseline_release_id": {"const": "end2end-agent-v3"},
    "kind": {"enum": ["smoke", "pilot"]},
    "seed": {"const": 1},
    "exploratory_pilot": {"const": true},
    "statistical_significance_claim_allowed": {"const": false},
    "system_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true},
    "task_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true},
    "run_count": {"enum": [1, 10, 40]},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["logical_run_id", "task_id", "system_id", "seed", "formal_result_eligible", "bindings", "row_hash"]
      }
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
